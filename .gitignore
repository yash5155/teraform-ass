# ==========================================
# Terraform
# ==========================================

# Terraform working directory
**/.terraform/

# Terraform state files
**/*.tfstate
**/*.tfstate.*
**/terraform.tfstate
**/terraform.tfstate.*

# Terraform crash logs
**/crash.log
**/crash.*.log

# Terraform variable files
**/*.tfvars
**/*.tfvars.json

# Exception: keep example variable files
!**/*.tfvars.example

# Terraform plans
**/*.tfplan
**/tfplan

# Terraform lock file
# KEEP THIS FILE in Git for provider version consistency
# **/.terraform.lock.hcl


# ==========================================
# Secrets / Environment Variables
# ==========================================

.env
.env.*
**/.env
**/.env.*

# Don't ignore example environment files
!.env.example
**/!.env.example


# ==========================================
# SSH / Private Keys
# ==========================================

*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# SSH keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub


# ==========================================
# Node.js
# ==========================================

**/node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/
.pnpm-store/


# ==========================================
# Python
# ==========================================

**/__pycache__/
**/*.py[cod]
**/*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/

.venv/
venv/
env/
ENV/

*.egg-info/


# ==========================================
# Build / Distribution
# ==========================================

**/dist/
**/build/
**/.cache/
**/coverage/


# ==========================================
# Logs
# ==========================================

**/*.log
logs/


# ==========================================
# Docker
# ==========================================

**/.docker/
docker-compose.override.yml


# ==========================================
# OS Files
# ==========================================

# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.directory


# ==========================================
# IDE / Editors
# ==========================================

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.idea/
*.iml

*.swp
*.swo


# ==========================================
# Temporary files
# ==========================================

*.tmp
*.temp
*.bak
*.backup
*.old

*.zip
*.rar
*.7z


# ==========================================
# Terraform Assignment Generated Files
# ==========================================

**/terraform.tfstate.backup
**/terraform.tfstate.d/

# Terraform local override files
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json

# Terraform provider lock files
**/.terraform.lock.hcl

images/